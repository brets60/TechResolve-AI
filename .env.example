# ==============================================================================
# TechResolve AI Environment Configuration (Railway / Production)
# ==============================================================================

# Server Port (Railway automatically sets PORT, defaults to 8000 locally)
PORT=8000

# Security: Secret key for signing JWT user tokens (generate a random 32+ character string in production)
SECRET_KEY=change-me-to-a-random-secure-string-in-production-2026

# Google Gemini API Key (Optional: enables live AI diagnostics. If empty, the built-in IT engine runs)
GEMINI_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Database Connection (Leave empty or commented out for SQLite; Railway PostgreSQL sets DATABASE_URL automatically)
# DATABASE_URL=sqlite:///./techresolve.db
